# ----------------------------------------------------------------- 运行模式
# 构建期开关，运行时不可篡改。
# true  = 单人私人版：五个功能页无需登录；账号只在「设置」里作为可选入口；
#         关闭公开注册 / 短信登录 / 密码重置；AI 只保留一个服务商。
# false = 多用户账号版：保持登录门控。
VITE_ANDROID_SINGLE_USER=true

# 账号服务地址（完全可选）。单人私人版不需要任何账号服务，正式包留空即可，
# 此时账号页显示"未配置服务"，本机功能一律不受影响。
# 仅当你确实部署了账号服务时，才填真实 HTTPS 地址。
VITE_AUTH_ENDPOINT=

# 仅调试/验收构建设为 true：启用安卓诊断入口与非 HTTPS 本地端点放行。
# 正式发布构建必须留空。
VITE_ENABLE_ANDROID_DIAGNOSTICS=

# ----------------------------------------------------------------- 账号服务（可选，方案 B：网页端 AI 服务端代理）
NODE_ENV=development
AUTH_PORT=8787
AUTH_HOST=0.0.0.0
# silent / error / info / debug；生产建议 info。
AUTH_LOG_LEVEL=info
# 生产环境填写前端真实 HTTPS 来源；Android/Tauri 原生页面可保留精确的 tauri.localhost 来源；不要使用 *。
AUTH_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost,http://tauri.localhost,https://tauri.localhost

# 生产环境必须通过进程环境变量注入，不要提交真实 Key。
AI_API_KEY=
AI_ENDPOINT=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat
