# 账号服务（方案 B：网页端 AI 服务端代理）
NODE_ENV=development
AUTH_PORT=8787
AUTH_HOST=0.0.0.0
# silent / error / info / debug；生产建议 info。
AUTH_LOG_LEVEL=info
# 生产环境填写前端真实 HTTPS 来源；Android/Tauri 原生页面可保留精确的 tauri.localhost 来源；不要使用 *。
AUTH_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost,http://tauri.localhost,https://tauri.localhost

# 生产环境必须通过进程环境变量注入，不要提交真实 Key。
AI_API_KEY=
AI_ENDPOINT=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat
