{
  "name": "route-planner",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-all.mjs",
    "dev:frontend": "vite",
    "dev:all": "node server/dev-all.mjs",
