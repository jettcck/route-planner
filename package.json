    "verify:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "release:check": "node server/release-check.mjs",
    "release:assets-test": "node server/release-assets-test.mjs",
    "release:frontend-config-check": "node server/frontend-config-check.mjs",
    "release:environment-check": "node server/release-env-check.mjs",
    "release:environment-test": "node server/release-env-test.mjs",
    "deploy:config-test": "node server/deploy-config-test.mjs",
    "deploy:render-test": "node server/deploy-render-test.mjs",
    "verify": "npm run auth:config-check && npm run auth:config-test && npm run auth:transport-test && npm run auth:smoke && npm run auth:client-test && npm run auth:routing-test && npm run auth:data-test && npm run auth:ai-test && npm run auth:password-reset-test && npm run auth:single-user-test && npm run travel-agent:test && npm run trip:generation-test && npm run weather:registration-test && npm run weather:resilience-test && npm run data:sanitizer-test && npm run storage:key-test && npm run storage:migration-test && npm run backup:test && npm run ledger:test && npm run budget:test && npm run reminders:test && npm run dev:supervisor-test && npm run release:assets-test && npm run release:check && npm run deploy:render-test && npm run build",
    "build": "node server/clean-dist.mjs && tsc && vite build && node server/frontend-bundle-check.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "storage:migration-test": "node server/storage-migration-test.mjs",
    "backup:test": "node server/backup-test.mjs"
