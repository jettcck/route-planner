    "auth:config-check": "node --env-file-if-exists=.env server/config-check.mjs",
    "auth:config-test": "node server/config-check-test.mjs",
    "auth:transport-test": "node server/production-transport-test.mjs",
    "auth:smoke": "node server/smoke-test.mjs",
    "auth:client-test": "node server/auth-request-test.mjs",
    "auth:routing-test": "node server/request-routing-test.mjs",
    "auth:ai-test": "node server/ai-proxy-test.mjs",
    "auth:password-reset-test": "node server/password-reset-test.mjs",
    "auth:single-user-test": "node server/single-user-policy-test.mjs",
    "travel-agent:test": "node server/travel-agent-test.mjs",
    "trip:generation-test": "node server/trip-generation-test.mjs",
    "dev:supervisor-test": "node server/dev-supervisor-test.mjs",
    "weather:registration-test": "node server/weather-registration-test.mjs",
    "weather:resilience-test": "node server/weather-resilience-test.mjs",
    "data:sanitizer-test": "node server/data-sanitizer-test.mjs",
    "storage:key-test": "node server/storage-key-test.mjs",
    "ledger:test": "node server/ledger-test.mjs",
    "budget:test": "node server/budget-test.mjs",
    "reminders:test": "node server/reminders-test.mjs",
    "auth:data-test": "node server/data-recovery-test.mjs",
