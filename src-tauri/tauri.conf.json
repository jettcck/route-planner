{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "途迹 Route",
  "version": "0.3.9",
  "identifier": "com.luyou.planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "途迹 · 行程规划",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' https: http://localhost:* http://127.0.0.1:* http://10.0.2.2:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "android": {
      "versionCode": 3009
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNDg2MUIyQTZDQTQwRTIKUldUaVFNcW1zbUZJOGlqajc0RUh2aXFVWFlMR0g3K0ZwbGZWYmVzQ01vQklzSHZyODZyMVNGaU8K",
      "endpoints": [
        "https://github.com/jettcck/route-planner/releases/latest/download/latest.json"
      ]
    }
  }
}
